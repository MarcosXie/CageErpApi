        </PackageReference>
        <PackageReference Include="Microsoft.OpenApi" Version="1.6.14" />
        <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
        <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\FlyGates.Application\FlyGates.Application.csproj" />
      <ProjectReference Include="..\FlyGates.Domain\FlyGates.Domain.csproj" />
      <ProjectReference Include="..\FlyGates.Infrastructure\FlyGates.Infrastructure.csproj" />
      <ProjectReference Include="..\FlyGates.Repository\FlyGates.Repository.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Content Update="appsettings.Development.json">
        <DependentUpon>appsettings.json</DependentUpon>
      </Content>
    </ItemGroup>

</Project>
