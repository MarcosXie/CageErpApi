{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "UploadCageOutsMedia",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": [
        "arn:aws:s3:::cageouts-media-prod/videos/*",
        "arn:aws:s3:::cageouts-media-prod/rejects/images/*"
      ]
    },
    {
      "Sid": "DetectLabels",
      "Effect": "Allow",
      "Action": "rekognition:DetectLabels",
      "Resource": "*"
    },
    {
      "Sid": "DenyAmazonBedrock",
      "Effect": "Deny",
      "Action": "bedrock:*",
      "Resource": "*"
    }
  ]
}
