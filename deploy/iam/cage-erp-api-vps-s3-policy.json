{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ManageCageOutsMediaObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::cageouts-media-prod/*"
    },
    {
      "Sid": "ManageCageOutsMediaLifecycle",
      "Effect": "Allow",
      "Action": "s3:PutLifecycleConfiguration",
      "Resource": "arn:aws:s3:::cageouts-media-prod"
    },
    {
      "Sid": "DenyAmazonBedrock",
      "Effect": "Deny",
      "Action": "bedrock:*",
      "Resource": "*"
    }
  ]
}
